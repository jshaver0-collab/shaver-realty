---
const { 
  title = "Shaver Realty Group | Listing Agent in Grapevine & Flower Mound TX",
  description = "Looking to sell your house in Grapevine, Flower Mound, Colleyville or Southlake? Shaver Realty Group offers transparent full-service listing plans starting at 2% with professional marketing and personal attention."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://shaverrealtygroup.com");

const schema = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  "@id": "https://shaverrealtygroup.com/#RealEstateAgent",
  "name": "Shaver Realty Group",
  "image": "https://shaverrealtygroup.com/logo.png",
  "url": "https://shaverrealtygroup.com/",
  "telephone": "+1-214-717-2888",
  "email": "john@shaverrealtygroup.com",
  "description": "Shaver Realty Group helps homeowners sell their homes in Grapevine, Flower Mound, Colleyville and Southlake with transparent pricing starting at 2%, professional marketing, and personal attention.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Grapevine",
    "addressRegion": "TX",
    "postalCode": "76051",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 32.9342,
    "longitude": -97.0781
  },
  "areaServed": [
    { "@type": "City", "name": "Grapevine" },
    { "@type": "City", "name": "Flower Mound" },
    { "@type": "City", "name": "Colleyville" },
    { "@type": "City", "name": "Southlake" }
  ],
  "priceRange": "$$",
  "sameAs": [
    "https://www.facebook.com/profile.php?id=61559560264010",
    "https://www.instagram.com/jshaver0/",
    "https://www.linkedin.com/in/shaverjohn/",
    "https://www.zillow.com/profile/ShaverRealtyGroup"
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://shaverrealtygroup.com/logo.png" />
    <meta property="og:site_name" content="Shaver Realty Group" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://shaverrealtygroup.com/logo.png" />

    <!-- Geo -->
    <meta name="geo.region" content="US-TX" />
    <meta name="geo.placename" content="Grapevine" />
    <meta name="geo.position" content="32.9342;-97.0781" />
    <meta name="ICBM" content="32.9342, -97.0781" />

    <!-- Google Site Verification -->
    <meta name="google-site-verification" content="1ui47Cay7xD0LmR-GAs4AZ9A1-EZyjU_s3Q0DkfsKu8" />

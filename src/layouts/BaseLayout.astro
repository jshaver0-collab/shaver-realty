</html>

<style is:global>
  :root {
    --primary: #111111;
    --accent: #1a1a1a;
    --text: #1a1a1a;
    --muted: #555555;
    --light: #f8f8f8;
    --border: #e5e5e5;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
a {
  color: inherit;
  text-decoration: none;
}

a:hover {
  color: #111;
  text-decoration: underline;
}

/* Prevent purple visited links */
a:visited {
  color: inherit;
}
  body {
    font-family: 'Inter', system-ui, sans-serif;
    color: var(--text);
    line-height: 1.6;
    background: #ffffff;
  }

  h1, h2, h3 {
    font-family: 'Lora', Georgia, serif;
  }

  .container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Dropdown */
  .nav-dropdown {
    position: relative;
    display: inline-block;
    margin-left: 2rem;
  }

  .nav-dropdown-toggle {
    background: none;
    border: none;
    color: var(--muted);
    font-weight: 500;
    font-size: 0.95rem;
    font-family: inherit;
    cursor: pointer;
    display: flex;
    align-items: center;
    padding: 0;
    transition: color 0.2s;
  }

  .nav-dropdown-toggle:hover,
  .nav-dropdown:hover .nav-dropdown-toggle {
    color: var(--primary);
  }

  .nav-dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: white;
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);
    min-width: 180px;
    padding: 0.5rem 0;
    z-index: 100;
  }

  .nav-dropdown::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 12px;
  }

  .nav-dropdown:hover .nav-dropdown-menu {
    display: block;
  }

  .nav-dropdown-menu a {
    display: block;
    padding: 0.6rem 1.25rem;
    margin: 0;
    color: #333;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .nav-dropdown-menu a:hover {
    background: #f8f8f8;
    color: #111;
  }

  /* Header */
  .site-header {
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 110px;         
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-img {
    height: 96px;          
    width: auto;
    display: block;
  }

  nav a {
    margin-left: 2rem;
    color: var(--muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  nav a:hover {
    color: var(--primary);
  }

  /* Footer */
  .site-footer {
    background: var(--light);
    padding: 3.5rem 0 2.5rem;
    border-top: 1px solid var(--border);
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin-bottom: 1.75rem;
  }

  .footer-brand strong {
    font-size: 1.15rem;
    color: #111;
  }

  .footer-broker {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .broker-label {
    font-size: 0.8rem;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .broker-logo {
    height: 52px;          
    width: auto;
  }

  .footer-contact a {
    color: #111;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .footer-areas {
    color: #555;
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
  }

  @media (max-width: 700px) {
    .header-inner {
      height: 90px;
    }
    .logo-img {
      height: 70px;
    }
    nav a {
      margin-left: 1.1rem;
      font-size: 0.9rem;
    }
    .broker-logo {
      height: 38px;
    }
    .nav-dropdown {
      margin-left: 1.1rem;
    }
    .nav-dropdown-menu {
      left: 0;
      transform: none;
    }
  }.areas-section {
  padding: 4.5rem 0;
  text-align: center;
  background: #f8f8f8;
  margin-bottom: 4rem;  
}

.areas-section h2 {
  font-size: 2.1rem;
  margin-bottom: 0.75rem;
}

.areas-section .intro-text {
  font-size: 1.15rem;
  color: #555;
  max-width: 600px;
  margin: 0 auto 2rem;
}

.areas-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 1.25rem;
  max-width: 820px;
  margin: 0 auto;
}

.area-card {
  background: white;
  border: 1px solid #e5e5e5;
  border-radius: 10px;
  padding: 1.4rem 1rem;
  font-weight: 600;
  font-size: 1.05rem;
  color: #111;
  text-decoration: none;
  transition: all 0.2s ease;
}

.area-card:hover {
  border-color: #111;
  box-shadow: 0 8px 20px -8px rgba(0,0,0,0.12);
  transform: translateY(-2px);
}

@media (max-width: 600px) {
  .areas-grid {
    grid-template-columns: 1fr 1fr;
  }
}
.faq-section {
  padding: 4.5rem 0;
  background: #f8f8f8;
}

.faq-section h2 {
  text-align: center;
  font-size: 2rem;
  margin-bottom: 2.5rem;
}

.faq-item {
  background: white;
  border: 1px solid #e5e5e5;
  border-radius: 10px;
  padding: 1.5rem 1.75rem;
  margin-bottom: 1.1rem;
}

.faq-item h3 {
  font-size: 1.15rem;
  margin-bottom: 0.6rem;
  color: #111;
}

.faq-item p {
  color: #444;
  line-height: 1.6;
  margin: 0;
  font-size: 1rem;
}
  .intro-section {
    padding: 3.5rem 0 1rem;
    text-align: center;
  }

  .intro-text {
    font-size: 1.2rem;
    line-height: 1.7;
    max-width: 780px;
    margin: 0 auto;
    color: #444;
  }
  .footer-trec {
  margin-top: 1.5rem;
  font-size: 0.85rem;
  color: #666;
  text-align: center;
}

.footer-trec a {
  color: #555;
  text-decoration: none;
}

.footer-trec a:hover {
  text-decoration: underline;
}
</style>
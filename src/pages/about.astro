---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout 
  title="About John Shaver | Grapevine Listing Agent | Shaver Realty Group"
  description="Meet John Shaver and Shaver Realty Group. We help homeowners sell in Grapevine, Flower Mound, Colleyville, and Southlake with clear communication, professional marketing, and a straightforward process."
>
  <section class="page-hero">
    <div class="container">
      <h1>About Shaver Realty Group</h1>
      <p class="lead">
        A clear, focused listing experience for homeowners in Grapevine and the surrounding communities.
      </p>
    </div>
  </section>

  <section class="about-content">
    <div class="container">
      <div class="intro">
        <h2>Hi, I’m John Shaver</h2>
        <p>
          I help homeowners in Grapevine, Flower Mound, Colleyville, Southlake, and nearby areas sell with clarity and confidence.
        </p>
        <p>
          Shaver Realty Group was built around a simple idea: sellers deserve transparent pricing, direct communication, and a straightforward process that doesn’t feel stressful or confusing.
        </p>
      </div>

      <div class="values-grid">
        <div class="value-card">
          <h3>Transparent Pricing</h3>
          <p>One full-service listing fee based on your home’s value. No complicated plans or hidden costs — just clear pricing and professional marketing on every listing.</p>
        </div>
        <div class="value-card">
          <h3>High-Touch Service</h3>
          <p>Clear updates and honest guidance from the first conversation through closing. You work directly with your listing agent at Shaver Realty Group.</p>
        </div>
        <div class="value-card">
          <h3>Local Focus</h3>
          <p>Deep knowledge of the Grapevine, Flower Mound, Colleyville, and Southlake markets. Strategy built for these specific communities, not a generic approach.</p>
        </div>
      </div>

      <div class="approach">
        <h2>Our Approach</h2>
        <p>
          Selling a home is one of the biggest financial decisions most people make. Our job is to make that process as straightforward and low-stress as possible while still delivering strong results.
        </p>
        <p>
          That means honest pricing advice, professional photography and marketing, careful preparation, and clear communication every step of the way — whether you’re selling in Grapevine or one of the surrounding communities.
        </p>
      </div>

      <!-- Areas We Serve -->
      <section class="areas-section">
        <div class="container">
          <h2>Areas We Serve</h2>
          <p class="intro-text">
            We help homeowners sell in these North Texas communities:
          </p>
          <div class="areas-grid">
            <a href="/grapevine" class="area-card">Grapevine</a>
            <a href="/flower-mound" class="area-card">Flower Mound</a>
            <a href="/colleyville" class="area-card">Colleyville</a>
            <a href="/southlake" class="area-card">Southlake</a>
          </div>
        </div>
      </section>

      <div class="cta-box">
        <h3>Ready to talk about selling your home?</h3>
        <p>Request a free home valuation or just reach out — we’re happy to answer questions with no pressure.</p>
        <div class="cta-buttons">
          <a href="/evaluation" class="btn btn-dark">Request Free Evaluation</a>
          <a href="tel:2147172888" class="btn">(214) 717-2888</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: #f8f8f8;
    padding: 4.5rem 0 3.5rem;
    text-align: center;
    border-bottom: 1px solid #e5e5e5;
  }

  .page-hero h1 {
    font-size: 2.5rem;
    color: #111;
    margin-bottom: 1rem;
  }

  .lead {
    font-size: 1.25rem;
    color: #555;
    max-width: 640px;
    margin: 0 auto;
  }

  .about-content {
    padding: 5rem 0 6rem;
  }

  .intro {
    max-width: 700px;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .intro h2 {
    font-size: 1.9rem;
    margin-bottom: 1.25rem;
    color: #111;
  }

  .intro p {
    color: #444;
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 1.1rem;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.75rem;
    margin-bottom: 4.5rem;
  }

  .value-card {
    background: white;
    border: 1px solid #e5e5e5;
    border-radius: 12px;
    padding: 1.9rem;
  }

  .value-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.7rem;
    color: #111;
  }

  .value-card p {
    color: #555;
    line-height: 1.6;
  }

  .approach {
    max-width: 700px;
    margin: 0 auto 4.5rem;
  }

  .approach h2 {
    font-size: 1.7rem;
    margin-bottom: 1.2rem;
    color: #111;
  }

  .approach p {
    color: #444;
    font-size: 1.08rem;
    line-height: 1.7;
    margin-bottom: 1.1rem;
  }

  .areas-section {
    margin-bottom: 4.5rem;
    text-align: center;
  }

  .areas-section h2 {
    font-size: 1.7rem;
    margin-bottom: 1rem;
    color: #111;
  }

  .intro-text {
    color: #555;
    margin-bottom: 1.5rem;
  }

  .areas-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .area-card {
    display: inline-block;
    padding: 0.8rem 1.6rem;
    background: white;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    text-decoration: none;
    color: #111;
    font-weight: 500;
    transition: all 0.2s;
  }

  .area-card:hover {
    background: #111;
    color: white;
    border-color: #111;
  }

  .cta-box {
    background: #f8f8f8;
    border-radius: 12px;
    padding: 3rem 2rem;
    text-align: center;
    max-width: 680px;
    margin: 0 auto;
  }

  .cta-box h3 {
    font-size: 1.5rem;
    margin-bottom: 0.7rem;
    color: #111;
  }

  .cta-box p {
    color: #555;
    margin-bottom: 1.75rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.9rem 1.8rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    border: 2px solid #111;
    color: #111;
    transition: all 0.2s;
  }

  .btn:hover {
    background: #111;
    color: white;
  }

  .btn-dark {
    background: #111;
    color: white;
  }

  .btn-dark:hover {
    background: #333;
  }

  @media (max-width: 600px) {
    .page-hero h1 {
      font-size: 2rem;
    }
  }
</style>
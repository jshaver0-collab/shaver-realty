---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout 
  title="Shaver Realty Group | Listing Agent in Grapevine & Flower Mound TX"
  description="Shaver Realty Group helps homeowners sell in Grapevine, Flower Mound, Colleyville, and Southlake with professional marketing, clear communication, and transparent listing service."
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      
      <h1>Your Grapevine Listing Specialist</h1>
      
      <h2 class="hero-sub">Professional Marketing. Clear Communication. Strong Results.</h2>
      
      <p class="subtitle">
        We help homeowners sell in Grapevine, Flower Mound, Colleyville, and Southlake 
        with full-service marketing, local expertise, and a straightforward process.
      </p>

      <div class="hero-buttons">
        <a href="/evaluation" class="btn btn-primary">Get Your Free Home Valuation</a>
        <a href="/pricing" class="btn btn-secondary">View Listing Options</a>
      </div>
    </div>
  </section>

  <!-- Premium Service. Clear Value. -->
  <section class="value-section">
    <div class="container">
      <h2>Premium Service. Clear Value.</h2>
      <div class="value-grid">
        <div class="value-card">
          <h3>Full-Service Marketing</h3>
          <p>Professional photography, strategic pricing, digital marketing, and open houses when they help — all included when you list with Shaver Realty Group.</p>
        </div>
        <div class="value-card">
          <h3>Transparent Pricing</h3>
          <p>Clear communication from start to finish. No hidden fees. No surprises at closing.</p>
        </div>
        <div class="value-card">
          <h3>Personal Attention</h3>
          <p>Direct access to your listing agent with high-level service and responsiveness throughout the process.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Transparent Pricing Highlight -->
  <section class="pricing-highlight">
    <div class="container">
      <h2>Transparent Listing Options</h2>
      <p class="pricing-text">
        Full-service listing with clear, upfront pricing based on your home’s value. 
        Professional marketing, photography, and dedicated support — everything needed to sell in Grapevine, Flower Mound, and the surrounding communities.
      </p>
      <a href="/pricing" class="btn btn-dark">View Listing Options</a>
    </div>
  </section>

  <!-- A Different Approach -->
  <section class="different-approach">
    <div class="container">
      <h2>A Focused Approach to Selling</h2>
      <p>
        Selling a home should feel straightforward. You get professional marketing, local market knowledge, and clear communication without unnecessary complexity.
      </p>
      <p>
        At Shaver Realty Group we stay focused on the details that matter — pricing, positioning, negotiation, and keeping you informed — so the process stays clear from the first conversation through closing.
      </p>
    </div>
  </section>

  <!-- How Selling Works -->
  <section class="process-section">
    <div class="container">
      <h2>How Selling Your Home Works</h2>
      <div class="process-grid">
        <div class="process-step">
          <h3>1. Free Home Valuation</h3>
          <p>Receive a realistic, data-driven valuation based on current market conditions in Grapevine and surrounding areas.</p>
        </div>
        <div class="process-step">
          <h3>2. Custom Marketing Plan</h3>
          <p>We create a tailored strategy including professional photography, staging guidance, and targeted marketing.</p>
        </div>
        <div class="process-step">
          <h3>3. Full-Service Execution</h3>
          <p>From listing to open houses and negotiations, you receive hands-on support and clear communication every step of the way.</p>
        </div>
        <div class="process-step">
          <h3>4. Close With Confidence</h3>
          <p>We handle the details so you can focus on your next move — with full transparency throughout the process.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Areas We Serve -->
  <section class="areas-section">
    <div class="container">
      <h2>Areas We Serve</h2>
      <p class="intro-text">
        We help homeowners sell in these North Texas communities:
      </p>
      <div class="areas-grid">
        <a href="/grapevine" class="area-card">Grapevine</a>
        <a href="/flower-mound" class="area-card">Flower Mound</a>
        <a href="/colleyville" class="area-card">Colleyville</a>
        <a href="/southlake" class="area-card">Southlake</a>
      </div>
    </div>
  </section>

  <!-- Cash Offers Section -->
  <section class="cash-section">
    <div class="container">
      <h2>Need to Sell Your Home Fast?</h2>
      <p>
        If you need to sell your house quickly and want to avoid repairs, staging, and showings, we can help you explore cash offers. Through our network of investors and cash buyers, we can often bring you multiple competitive offers to consider.
      </p>
      <div class="benefits">
        <h3>Potential Benefits:</h3>
        <ul>
          <li>No need to make repairs or updates to the home</li>
          <li>No showings or open houses required</li>
          <li>Faster closing timeline</li>
          <li>More certainty with fewer contingencies</li>
        </ul>
      </div>
      <a href="/cash-offer" class="btn btn-dark">Request a Cash Offer</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    background-image: url('/hero-bg.jpg');
    background-size: cover;
    background-position: center;
    color: white;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.72) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 6rem 0;
  }

  .hero h1 {
    font-family: 'Lora', Georgia, serif;
    font-size: 3.2rem;
    font-weight: 500;
    line-height: 1.15;
    margin: 0 auto 0.6rem;
    letter-spacing: -0.02em;
  }

  .hero-sub {
    font-family: 'Lora', Georgia, serif;
    font-size: 1.7rem;
    font-weight: 500;
    margin: 0 auto 2rem;
    opacity: 0.95;
    letter-spacing: -0.01em;
  }

  .subtitle {
    font-size: 1.25rem;
    max-width: 720px;
    margin: 0 auto 2.75rem;
    line-height: 1.65;
    opacity: 0.95;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary {
    background: white;
    color: #111;
  }

  .btn-primary:hover {
    background: #f0f0f0;
  }

  .btn-secondary {
    background: transparent;
    color: white;
    border: 2px solid rgba(255,255,255,0.75);
  }

  .btn-secondary:hover {
    border-color: white;
    background: rgba(255,255,255,0.1);
  }

  .btn-dark {
    background: #111;
    color: white;
  }

  .btn-dark:hover {
    background: #333;
  }

  .value-section {
    padding: 5.5rem 0;
    text-align: center;
  }

  .value-section h2 {
    font-size: 2.3rem;
    margin-bottom: 3rem;
    color: #111;
  }

  .value-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2.5rem;
    text-align: left;
  }

  .value-card h3 {
    font-size: 1.4rem;
    margin-bottom: 0.9rem;
    color: #111;
  }

  .value-card p {
    font-size: 1.1rem;
    line-height: 1.65;
    color: #444;
  }

  .pricing-highlight {
    background: #f8f8f8;
    padding: 5rem 0;
    text-align: center;
  }

  .pricing-highlight h2 {
    font-size: 2.2rem;
    margin-bottom: 1.5rem;
    color: #111;
  }

  .pricing-text {
    font-size: 1.25rem;
    max-width: 750px;
    margin: 0 auto 2rem;
    line-height: 1.7;
    color: #333;
  }

  .different-approach {
    padding: 5.5rem 0;
    text-align: center;
  }

  .different-approach h2 {
    font-size: 2.3rem;
    margin-bottom: 2rem;
    color: #111;
  }

  .different-approach p {
    font-size: 1.2rem;
    line-height: 1.75;
    max-width: 800px;
    margin: 0 auto 1.4rem;
    color: #333;
  }

  .process-section {
    background: #f8f8f8;
    padding: 5.5rem 0;
  }

  .process-section h2 {
    text-align: center;
    font-size: 2.3rem;
    margin-bottom: 3.5rem;
    color: #111;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2.5rem;
  }

  .process-step h3 {
    font-size: 1.3rem;
    margin-bottom: 0.8rem;
    color: #111;
  }

  .process-step p {
    font-size: 1.1rem;
    line-height: 1.65;
    color: #444;
  }

  .cash-section {
    padding: 5.5rem 0;
    text-align: center;
  }

  .cash-section h2 {
    font-size: 2.2rem;
    margin-bottom: 1.5rem;
    color: #111;
  }

  .cash-section > .container > p {
    font-size: 1.2rem;
    line-height: 1.7;
    max-width: 780px;
    margin: 0 auto 2rem;
    color: #333;
  }

  .benefits {
    text-align: left;
    max-width: 600px;
    margin: 0 auto 2.5rem;
  }

  .benefits h3 {
    font-size: 1.3rem;
    margin-bottom: 1rem;
    color: #111;
  }

  .benefits ul {
    list-style: none;
    padding: 0;
  }

  .benefits li {
    font-size: 1.15rem;
    line-height: 1.8;
    color: #333;
    padding-left: 1.5rem;
    position: relative;
  }

  .benefits li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: #111;
    font-weight: bold;
  }

  @media (max-width: 700px) {
    .hero h1 {
      font-size: 2.4rem;
    }
    .hero-sub {
      font-size: 1.35rem;
    }
  }
</style>
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout 
  title="Transparent Listing Fees by Home Value | Shaver Realty Group"
  description="Clear, full-service listing fees based on your home’s value. Professional photography, MLS exposure, negotiation, and dedicated support for every listing in Grapevine, Flower Mound, Colleyville, and Southlake."
>
  <!-- HERO -->
  <section class="page-hero">
    <div class="container">
      <h1>Transparent Listing Fees</h1>
      <p class="lead">
        One full-service listing for every home.<br />
        The fee adjusts with the value of the property so it stays reasonable as home prices have risen.<br />
        Serving Grapevine • Flower Mound • Colleyville • Southlake
      </p>
      <a href="/evaluation" class="btn btn-dark">Get a Free Valuation & See Your Exact Fee →</a>
      <p class="hero-note">Shaver Realty Group</p>
    </div>
  </section>

  <!-- FEE BANDS -->
  <section class="tiers-section">
    <div class="container">
      <h2>Listing Fee by Home Value</h2>
      <p class="intro-text">
        Same professional service on every listing. Your fee is calculated on the final sale price and falls into one of these straightforward ranges.
      </p>

      <div class="tiers-grid">

        <div class="plan">
          <h3>Homes under $500,000</h3>
          <div class="price">1.75% <span>of sale price</span></div>
          <p class="plan-desc">Full-service listing</p>
        </div>

        <div class="plan popular">
          <div class="badge">MOST COMMON</div>
          <h3>$500,000 – $800,000</h3>
          <div class="price">1.5% <span>of sale price</span></div>
          <p class="plan-desc">Full-service listing</p>
        </div>

        <div class="plan">
          <h3>Homes over $800,000</h3>
          <div class="price">1.25% <span>of sale price</span></div>
          <p class="plan-desc">Full-service listing</p>
        </div>

      </div>

      <p class="center-note">
        Full-service listing on every home. No reduced service at any price.<br />
        Exact fee confirmed after a free, no-obligation valuation. Calculated on final sale price.
      </p>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section class="included-section">
    <div class="container">
      <h2>What’s Included With Every Listing</h2>
      <div class="included-grid">
        <ul>
          <li>Professional photography</li>
          <li>Full MLS exposure + syndication (Zillow, Realtor.com, Homes.com and more)</li>
          <li>Pricing strategy and market analysis</li>
          <li>Side-by-side cash offer comparison</li>
          <li>Negotiation and contract support through closing</li>
          <li>Direct access to your listing agent</li>
        </ul>
        <ul>
          <li>BrokerBay showing coordination</li>
          <li>Open houses when beneficial</li>
          <li>Ongoing communication and updates</li>
          <li>Local market knowledge and positioning</li>
          <li>No hidden fees or surprise add-ons</li>
          <li>Personal attention from Shaver Realty Group</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="why-section">
    <div class="container">
      <h2>Why This Approach Works</h2>
      <div class="why-grid">
        <div>
          <strong>Fair as Prices Rise</strong>
          <p>Home values have increased significantly. The fee adjusts with the property so it stays reasonable for sellers.</p>
        </div>
        <div>
          <strong>Same Full Service</strong>
          <p>Every home receives professional photography, full MLS exposure, negotiation support, and personal attention—regardless of price.</p>
        </div>
        <div>
          <strong>Clear and Simple</strong>
          <p>No complicated plans or packages. One listing service with a transparent fee based on home value.</p>
        </div>
        <div>
          <strong>Local Focus</strong>
          <p>Specializing in Grapevine, Flower Mound, Colleyville, Southlake, and nearby areas.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta">
    <div class="container">
      <h2>Ready to See What Your Home Is Worth?</h2>
      <p>Get a free, no-obligation valuation and a clear picture of your listing fee.</p>
      <a href="/evaluation" class="btn btn-dark">Get My Free Home Valuation</a>
      <p class="phone">Or call/text directly: <strong>(214) 717-2888</strong><br />Shaver Realty Group</p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Why does the listing fee change with home value?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Home prices have risen significantly. The fee adjusts with the value of the property so it stays reasonable for sellers while still covering full-service marketing, negotiation, and support."
        }
      },
      {
        "@type": "Question",
        "name": "Is the service different at different price points?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Every home receives the same full-service listing: professional photography, full MLS exposure, pricing strategy, negotiation support, and ongoing communication."
        }
      },
      {
        "@type": "Question",
        "name": "When is the exact fee confirmed?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "After a free, no-obligation valuation. The fee is calculated on the final sale price and falls into one of the published ranges."
        }
      },
      {
        "@type": "Question",
        "name": "Are there any hidden fees or reduced service options?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. There are no hidden fees or surprise add-ons. Service does not change based on the fee percentage."
        }
      }
    ]
  })} />
</BaseLayout>

<style>
  /* Existing styles kept and lightly extended */
  .page-hero {
    background: #f8f8f8;
    color: #111;
    padding: 5.5rem 0 4.5rem;
    text-align: center;
  }

  .page-hero h1 {
    font-size: 2.8rem;
    margin-bottom: 1.25rem;
    font-weight: 500;
    color: #111;
  }

  .lead {
    font-size: 1.3rem;
    max-width: 740px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
    color: #444;
  }

  .hero-note {
    margin-top: 1.75rem;
    font-size: 1rem;
    color: #666;
  }

  .tiers-section {
    padding: 5rem 0 3rem;
  }

  .tiers-section h2 {
    text-align: center;
    font-size: 2.1rem;
    margin-bottom: 1rem;
  }

  .intro-text {
    text-align: center;
    font-size: 1.15rem;
    max-width: 700px;
    margin: 0 auto 3.5rem;
    color: #555;
  }

  .tiers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.75rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .plan {
    border: 1px solid #e5e5e5;
    border-radius: 14px;
    padding: 2.25rem 1.75rem;
    background: white;
    position: relative;
    text-align: center;
  }

  .plan.popular {
    border: 2px solid #111;
    box-shadow: 0 12px 30px -8px rgba(0,0,0,0.12);
  }

  .badge {
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%);
    background: #111;
    color: white;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.35rem 1.1rem;
    border-radius: 999px;
  }

  .plan h3 {
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
  }

  .price {
    font-size: 2.4rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 0.5rem;
  }

  .price span {
    font-size: 1rem;
    font-weight: 500;
    color: #555;
    display: block;
    margin-top: 0.25rem;
  }

  .plan-desc {
    color: #666;
    font-size: 0.95rem;
    margin-top: 0.5rem;
  }

  .center-note {
    text-align: center;
    margin-top: 2rem;
    color: #666;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .included-section {
    padding: 3rem 0 4rem;
  }

  .included-section h2 {
    text-align: center;
    font-size: 2.1rem;
    margin-bottom: 2rem;
  }

  .included-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .included-grid ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .included-grid li {
    padding: 0.4rem 0 0.4rem 1.5rem;
    position: relative;
    color: #333;
  }

  .included-grid li::before {
    content: "✔";
    position: absolute;
    left: 0;
    color: #111;
    font-weight: 700;
  }

  .why-section {
    background: #f8f8f8;
    padding: 5rem 0;
    text-align: center;
  }

  .why-section h2 {
    font-size: 2.1rem;
    margin-bottom: 2.5rem;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .why-grid strong {
    display: block;
    margin-bottom: 0.4rem;
    color: #111;
  }

  .why-grid p {
    color: #555;
    font-size: 0.98rem;
  }

  .final-cta {
    padding: 5rem 0;
    text-align: center;
  }

  .final-cta h2 {
    font-size: 2.1rem;
    margin-bottom: 1rem;
  }

  .final-cta p {
    font-size: 1.15rem;
    color: #555;
    margin-bottom: 2rem;
  }

  .phone {
    margin-top: 2.5rem;
    font-size: 1.1rem;
  }

  .btn {
    display: inline-block;
    padding: 1rem 2.2rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-dark {
    background: #111;
    color: white;
  }

  .btn-dark:hover {
    background: #333;
  }

  @media (max-width: 700px) {
    .page-hero h1 {
      font-size: 2.2rem;
    }
  }
</style>
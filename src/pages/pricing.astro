---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout 
  title="Full-Service Listing Plans Starting at 2% | Sell Your House in Grapevine & DFW"
  description="Transparent full-service listing plans starting at 2% for homeowners who want to sell their house in Grapevine, Flower Mound, Colleyville or Southlake. Professional marketing, MLS exposure, and open houses included."
>
  <!-- HERO -->
  <section class="page-hero">
    <div class="container">
      <h1>Full-Service Listing Plans</h1>
      <p class="lead">
        Professional marketing and transparent pricing for homeowners ready to sell.<br />
        Full MLS exposure + open houses included in every plan.<br />
        Serving Grapevine • Flower Mound • Colleyville • Southlake
      </p>
      <a href="#tiers" class="btn btn-dark">Choose Your Plan & Get a Free Valuation →</a>
      <p class="hero-note">Shaver Realty Group • Dedicated Listing Agent</p>
    </div>
  </section>

  <!-- INTRO + TIERS -->
  <section class="tiers-section">
    <div class="container">
      <h2>Choose Your Professional Listing Plan</h2>
      <p class="intro-text">
        Clear, transparent pricing with full professional service in every tier. 
        Whether you want to sell your house in Grapevine or the surrounding areas, 
        choose the level of marketing support that fits your home.
      </p>

      <div id="tiers" class="tiers-grid">

        <!-- Value Plan -->
        <div class="plan">
          <h3>Value Plan</h3>
          <p class="plan-desc">Professional service with essential marketing</p>
          <div class="price">2% <span>of sale price</span></div>
          <ul>
            <li>Professional photos + basic floor plan</li>
            <li>Full MLS + syndication to Zillow, Realtor.com, Homes.com + 25,000+ agents</li>
            <li>Compact digital ad campaign (Meta + Google)</li>
            <li>Professional video tour with paid promotion</li>
            <li>BrokerBay showing coordinator</li>
            <li class="highlight">Agent-hosted open houses included</li>
            <li>Full negotiation and closing support</li>
          </ul>
          <p class="note">*No Matterport or virtual staging included</p>
        </div>

        <!-- Most Popular -->
        <div class="plan popular">
          <div class="badge">MOST POPULAR</div>
          <h3>Most Popular Plan</h3>
          <p class="plan-desc">Best balance of marketing and value</p>
          <div class="price">2.5% <span>of sale price</span></div>
          <ul>
            <li>Professional photos + Matterport 3D tour + floor plan</li>
            <li>Full MLS + syndication to Zillow, Realtor.com, Homes.com + 25,000+ agents</li>
            <li>Focused digital ad campaign (Meta + Google)</li>
            <li>Professional video tour with paid promotion</li>
            <li>Virtual staging (3 rooms)</li>
            <li>“Just Listed” postcards + targeted agent outreach</li>
            <li>BrokerBay showing coordinator</li>
            <li class="highlight">Agent-hosted open houses included</li>
            <li>Full negotiation and closing support</li>
          </ul>
        </div>

        <!-- Premium -->
        <div class="plan">
          <h3>Premium Plan</h3>
          <p class="plan-desc">Maximum exposure for competitive markets</p>
          <div class="price">2.75% <span>of sale price</span></div>
          <ul>
            <li>Professional photos + Matterport 3D tour + aerial drone + detailed floor plan</li>
            <li>Full MLS + syndication to Zillow, Realtor.com, Homes.com + 25,000+ agents</li>
            <li>Extended digital ad campaign (Meta + Google)</li>
            <li>Professional video tour with paid promotion</li>
            <li>Virtual staging (3 rooms)</li>
            <li>“Just Listed” postcards + targeted agent outreach</li>
            <li>BrokerBay showing coordinator</li>
            <li class="highlight">Agent-hosted open houses included</li>
            <li>Full negotiation and closing support</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- WHY CHOOSE -->
  <section class="why-section">
    <div class="container">
      <h2>Why Sellers Choose Shaver Realty Group</h2>
      <div class="why-grid">
        <div>
          <strong>Transparent Pricing</strong>
          <p>Clear tiers with no hidden fees or surprises when you sell your house.</p>
        </div>
        <div>
          <strong>Full Professional Marketing</strong>
          <p>MLS syndication, pro photography, video, ads, and open houses included.</p>
        </div>
        <div>
          <strong>Consistent Service</strong>
          <p>Every plan includes dedicated support from your local listing agent through closing.</p>
        </div>
        <div>
          <strong>Local DFW Expertise</strong>
          <p>Specializing in helping homeowners sell in Grapevine, Colleyville, Flower Mound, Southlake and surrounding areas.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta">
    <div class="container">
      <h2>Ready to Sell Your House with Professional Representation?</h2>
      <p>Choose your plan above and receive a free, no-obligation home valuation.</p>
      <a href="/evaluation" class="btn btn-dark">Get My Free Home Valuation</a>
      <p class="phone">Or call/text directly: <strong>(214) 717-2888</strong><br />Shaver Realty Group</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: #f8f8f8;
    color: #111;
    padding: 5.5rem 0 4.5rem;
    text-align: center;
  }

  .page-hero h1 {
    font-size: 2.8rem;
    margin-bottom: 1.25rem;
    font-weight: 500;
    color: #111;
  }

  .lead {
    font-size: 1.3rem;
    max-width: 700px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
    color: #444;
  }

  .hero-note {
    margin-top: 1.75rem;
    font-size: 1rem;
    color: #666;
  }

  .tiers-section {
    padding: 5rem 0 4rem;
  }

  .tiers-section h2 {
    text-align: center;
    font-size: 2.1rem;
    margin-bottom: 1rem;
  }

  .intro-text {
    text-align: center;
    font-size: 1.15rem;
    max-width: 700px;
    margin: 0 auto 3.5rem;
    color: #555;
  }

  .tiers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  .plan {
    border: 1px solid #e5e5e5;
    border-radius: 14px;
    padding: 2.25rem 1.75rem;
    background: white;
    position: relative;
  }

  .plan.popular {
    border: 2px solid #111;
    box-shadow: 0 12px 30px -8px rgba(0,0,0,0.12);
  }

  .badge {
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%);
    background: #111;
    color: white;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.35rem 1.1rem;
    border-radius: 999px;
  }

  .plan h3 {
    font-size: 1.4rem;
    margin-bottom: 0.4rem;
  }

  .plan-desc {
    color: #666;
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
  }

  .price {
    font-size: 2.3rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 1.5rem;
  }

  .price span {
    font-size: 1rem;
    font-weight: 500;
    color: #555;
  }

  .plan ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
  }

  .plan li {
    padding: 0.45rem 0;
    padding-left: 1.5rem;
    position: relative;
    color: #333;
    font-size: 0.98rem;
  }

  .plan li::before {
    content: "✔";
    position: absolute;
    left: 0;
    color: #111;
    font-weight: 700;
  }

  .plan li.highlight {
    font-weight: 600;
    color: #111;
  }

  .note {
    font-size: 0.9rem;
    color: #777;
  }

  .why-section {
    background: #f8f8f8;
    padding: 5rem 0;
    text-align: center;
  }

  .why-section h2 {
    font-size: 2.1rem;
    margin-bottom: 2.5rem;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .why-grid strong {
    display: block;
    margin-bottom: 0.4rem;
    color: #111;
  }

  .why-grid p {
    color: #555;
    font-size: 0.98rem;
  }

  .final-cta {
    padding: 5rem 0;
    text-align: center;
  }

  .final-cta h2 {
    font-size: 2.1rem;
    margin-bottom: 1rem;
  }

  .final-cta p {
    font-size: 1.15rem;
    color: #555;
    margin-bottom: 2rem;
  }

  .phone {
    margin-top: 2.5rem;
    font-size: 1.1rem;
  }

  .btn {
    display: inline-block;
    padding: 1rem 2.2rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-dark {
    background: #111;
    color: white;
  }

  .btn-dark:hover {
    background: #333;
  }

  @media (max-width: 700px) {
    .page-hero h1 {
      font-size: 2.2rem;
    }
  }
</style>
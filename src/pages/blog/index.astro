---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout 
  title="Real Estate Blog | Grapevine, Flower Mound & DFW | Shaver Realty Group"
  description="Local real estate insights, neighborhood guides, and home selling tips for Grapevine, Flower Mound, Colleyville, and Southlake."
>
  <section class="page-hero">
    <div class="container">
      <h1>Real Estate Blog</h1>
      <p class="lead">Local market updates, neighborhood highlights, and practical advice for selling your home in Grapevine and the surrounding areas.</p>
    </div>
  </section>

  <section class="value-section">
    <div class="container">
      <div class="value-grid">
        {posts.map(post => (
          <div class="value-card">
            <h3>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h3>
            <p style="font-size: 0.95rem; color: #666; margin-bottom: 0.75rem;">
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            <p>{post.data.description}</p>
            <a href={`/blog/${post.id}/`} style="font-weight: 600;">Read more →</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: #f8f8f8;
    padding: 5rem 0 4rem;
    text-align: center;
  }
  .page-hero h1 {
    font-size: 2.8rem;
    margin-bottom: 1rem;
  }
  .lead {
    font-size: 1.25rem;
    max-width: 700px;
    margin: 0 auto;
    color: #555;
  }
</style>
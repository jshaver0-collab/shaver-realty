---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout 
  title="What Is My Home Worth in Grapevine TX? | Free Home Evaluation"
  description="Get a free, no-obligation home evaluation in Grapevine, Flower Mound, Colleyville or Southlake. Find out what your house is worth from a local listing specialist. Transparent pricing starting at 2%."
>
  <section class="page-hero">
    <div class="container">
      <h1>What Is Your Home Worth?</h1>
      <p class="lead">
        Get a clear, realistic estimate of what your home is worth in today’s market. 
        Whether you want to sell your house in Grapevine or the surrounding areas, 
        I’ll provide an honest valuation with no obligation.
      </p>
    </div>
  </section>

  <section class="content">
    <div class="container narrow">
      <div class="form-card">
        <h2>Request Your Free Home Evaluation</h2>
        <p class="form-sub">
          Fill this out and I’ll personally call you within 24 hours to gather the details needed for an accurate evaluation of your Grapevine or nearby home.
        </p>

        <!-- Replace YOUR_FORM_ID later with your real Formspree (or similar) ID -->
        <form action="https://formspree.io/f/mjybzdpa" method="POST" class="eval-form"><input type="hidden" name="_next" value="https://shaver-realty.pages.dev/thank-you" />
          <div class="field">
            <label for="name">Full Name *</label>
            <input type="text" id="name" name="name" required />
          </div>

          <div class="field">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required />
          </div>

          <div class="field">
            <label for="phone">Phone *</label>
            <input type="tel" id="phone" name="phone" required />
          </div>

          <div class="field">
            <label for="address">Property Address (optional)</label>
            <input type="text" id="address" name="address" placeholder="Street, City, ZIP" />
          </div>

          <div class="checkbox-field">
            <input type="checkbox" id="interest" name="interest" value="yes" required />
            <label for="interest">I’m interested in a free home evaluation</label>
          </div>

          <button type="submit" class="btn-primary">Get My Free Home Valuation</button>
        </form>

        <p class="privacy">Your information stays private. No spam, ever.</p>
      </div>

      <div class="below-form">
        <p>Prefer to talk now?</p>
        <p class="contact-line">
          <a href="tel:2147172888">(214) 717-2888</a> &nbsp;•&nbsp; 
          <a href="mailto:john@shaverrealtygroup.com">john@shaverrealtygroup.com</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: #f8f8f8;
    padding: 4rem 0 3rem;
    text-align: center;
    border-bottom: 1px solid #e5e5e5;
  }

  .page-hero h1 {
    font-size: 2.5rem;
    color: #111;
    margin-bottom: 1rem;
  }

  .lead {
    font-size: 1.2rem;
    color: #555;
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .content {
    padding: 4rem 0 5rem;
  }

  .narrow {
    max-width: 520px;
    margin: 0 auto;
  }

  .form-card {
    background: white;
    border: 1px solid #e5e5e5;
    border-radius: 12px;
    padding: 2.25rem;
    box-shadow: 0 8px 25px -8px rgba(0,0,0,0.07);
  }

  .form-card h2 {
    font-size: 1.5rem;
    margin-bottom: 0.4rem;
    color: #111;
  }

  .form-sub {
    color: #666;
    font-size: 0.98rem;
    margin-bottom: 1.75rem;
    line-height: 1.5;
  }

  .field {
    margin-bottom: 1.15rem;
  }

  .field label {
    display: block;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 0.35rem;
    color: #333;
  }

  .field input {
    width: 100%;
    padding: 0.8rem 0.95rem;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 1rem;
    font-family: inherit;
  }

  .field input:focus {
    outline: none;
    border-color: #111;
  }

  .checkbox-field {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin: 1.5rem 0 1.75rem;
    font-size: 0.95rem;
    color: #444;
  }

  .checkbox-field input {
    margin-top: 0.2rem;
  }

  .btn-primary {
    width: 100%;
    background: #111;
    color: white;
    border: none;
    padding: 0.95rem;
    border-radius: 8px;
    font-size: 1.05rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-primary:hover {
    background: #333;
  }

  .privacy {
    font-size: 0.82rem;
    color: #888;
    text-align: center;
    margin-top: 1.1rem;
  }

  .below-form {
    text-align: center;
    margin-top: 2.5rem;
    color: #555;
  }

  .contact-line {
    margin-top: 0.4rem;
    font-size: 1.1rem;
  }

  .contact-line a {
    color: #111;
    text-decoration: none;
    font-weight: 500;
  }

  .contact-line a:hover {
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .page-hero h1 {
      font-size: 2rem;
    }
    .form-card {
      padding: 1.75rem;
    }
  }
</style>